<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraforum.mapper.ForumTagRelationMapper">
    <insert id="insert">
        insert into forum_tag_relation (tag_id,forum_id)
        values
        <foreach collection="tagsList" item="tagId" separator=",">
            (#{tagId},#{forumId})
        </foreach>
    </insert>
    <select id="selectTags" resultType="com.lcy.yozoraforum.entity.Tags">
        select t.tag_id, t.tag_name
        from forum_tag_relation f
                 left join tags t on t.tag_id = f.tag_id
        where f.forum_id = #{forumId};
    </select>
</mapper>