<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraforum.mapper.TopForumMapper">

    <insert id="insertTopForum">
        insert into top_forum (forum_id) values (#{forumId})
    </insert>

    <select id="getAllTopForumCount" resultType="java.lang.Integer">
        select count(*) from top_forum
    </select>
</mapper>