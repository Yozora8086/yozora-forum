<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraforum.mapper.ForumMapper">
  <select id="showForumList" resultType="com.lcy.yozoraforum.entity.Forum">
      select * from forum order by create_date desc limit #{offset},#{pageSize}
  </select>

    <select id="showMineForumList" resultType="com.lcy.yozoraforum.entity.Forum">
        select * from forum where user_id = #{userId} order by create_date desc limit #{offset},#{pageSize}
    </select>

    <select id="selectForum" resultType="com.lcy.yozoraforum.entity.Forum">
        select * from forum where forum_id = #{forumId}
    </select>
</mapper>