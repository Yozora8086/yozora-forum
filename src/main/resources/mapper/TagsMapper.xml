<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lcy.yozoraforum.mapper.TagsMapper">
    <select id="selectTags" resultType="java.lang.Long">
        select tag_id from tags where
        <if test="tagsList != null and tagsList.size() > 0">
                tag_name in
            <foreach collection="tagsList" item="tagName" open="(" separator="," close=")">
                #{tagName,typeHandler=com.lcy.yozoraforum.entity.TagsTypeHandler}
            </foreach>
        </if>


--         避免数据库报错
        <if test="tagsList == null or tagsList.size() == 0">
            1 = 2
        </if>
    </select>
</mapper>